{
  "name": "google-photos-delete-tool",
  "version": "3.0.0",
  "private": true,
  "description": "Consent-gated bulk delete for Google Photos \u2014 Chrome/Firefox extension, userscript, and standalone script",
  "author": "Kyle Tse <shtse8@gmail.com>",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "bun run scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ scripts/",
    "lint:fix": "eslint src/ scripts/ --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "bun run scripts/verify.ts",
    "zip": "bun run scripts/zip.ts",
    "package": "bun run build && bun run verify && bun run zip",
    "license:keygen": "bun run scripts/license.ts keygen",
    "license:issue": "bun run scripts/license.ts issue",
    "license:verify": "bun run scripts/license.ts verify"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "archiver": "^7.0.1",
    "eslint": "^9.19.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.22.0",
    "vite": "^6.1.0",
    "vitest": "^4.0.18"
  }
}
